                "arn:aws:s3:::jackpotsworld-media/events/*",
                "arn:aws:s3:::jackpotsworld-media/spin/*",
                "arn:aws:s3:::jackpotsworld-media/wheel/*",
                "arn:aws:s3:::jackpotsworld-media/avatars/*",
                "arn:aws:s3:::jackpotsworld-media/andhar_bahar/*",
                "arn:aws:s3:::jackpotsworld-media/support/hold_audio/*"
            ]
        }
    ]
}
