# VOICE-CALL sweep, every minute, on EVERY instance.
#
# WHY THIS ONE JOB AND NOT THE SYNC JOBS
# ──────────────────────────────────────
# This environment runs more than one instance, so anything installed here runs
# more than once per tick. `sweep_expired_calls` is safe under that: both of
# its sweeps are conditional UPDATEs against a row still in the state being
# swept, and neither sends a notification — a second instance simply finds
# nothing to do. The sync jobs (sync_poker, sync_teenpatti_statuses) are NOT
# safe that way: they notify, and notifications are not deduplicated, so they
# stay unscheduled deliberately. See docs/DEPLOYMENT_SCHEDULER.md before adding
# anything to this file.
#
# WHAT BREAKS WITHOUT IT
# ──────────────────────
#   * a ring nobody ever looks at again stays `ringing`, holding its ticket's
#     single active-call slot and blocking the next call;
#   * a hold whose agent's tab crashed never ends, because a hold has no lazy
#     read path — the customer waits on hold audio indefinitely. That one has
#     no other safety net at all.
#
# The log is deliberately its own file so a noisy minute-ly job cannot bury the
# application log. Logrotate on Amazon Linux 2023 picks up /var/log/*.log.
files:
  "/etc/cron.d/jackpotsworld_calls":
    mode: "000644"
    owner: root
    group: root
    content: |
      # m h dom mon dow user command
      * * * * * root . /var/app/venv/*/bin/activate && cd /var/app/current && python manage.py sweep_expired_calls >> /var/log/jw_calls.log 2>&1

commands:
  # A cron.d file left behind by an earlier deploy would keep running the old
  # command line; clear the backup EB writes when it replaces the file.
  remove_old_cron_backup:
    command: "rm -f /etc/cron.d/jackpotsworld_calls.bak"
