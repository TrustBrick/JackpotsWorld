# Copy this file to `.env` on the server (cPanel File Manager or SSH) and
# fill in real values. Never commit the real `.env` — it's gitignored.
#
# Generate a secure SECRET_KEY with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

SECRET_KEY=replace-with-output-of-get_random_secret_key
DEBUG=False

# Comma-separated, no spaces — no api. subdomain, everything is one domain
ALLOWED_HOSTS=jackpotsworld.vip,www.jackpotsworld.vip
CORS_ALLOWED_ORIGINS=https://jackpotsworld.vip,https://www.jackpotsworld.vip
CSRF_TRUSTED_ORIGINS=https://jackpotsworld.vip,https://www.jackpotsworld.vip

# Set to True only after confirming HTTPS works via cPanel AutoSSL
SECURE_SSL_REDIRECT=False
# Only set True if your host puts a reverse proxy in front of Passenger
USE_X_FORWARDED_PROTO=False

# HSTS — leave at 0 until SECURE_SSL_REDIRECT/HTTPS is verified working
# (see DEPLOYMENT.md), then set to e.g. 31536000 (1 year). Browsers cache
# this aggressively, so don't turn it on until you're sure.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Absolute path to the built React app's dist/ folder (npm run build).
# Deploy it as a sibling of this Django app's root — see DEPLOYMENT.md.
# Default (if unset) assumes ~/jackpotsworld_frontend_dist next to this app.
FRONTEND_DIST_DIR=/home/cpaneluser/jackpotsworld_frontend_dist

# ── Database (create via cPanel > MySQL Database Wizard) ─────────────────────
# GoDaddy cPanel prefixes DB names/users with your cPanel username, e.g.
# cpaneluser_jackpotdb / cpaneluser_jackpotuser
DB_NAME=cpaneluser_jackpotdb
DB_USER=cpaneluser_jackpotuser
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=60
# Only set this when DB_HOST is an AWS RDS endpoint — path to the CA bundle
# this repo ships at certs/global-bundle.pem (downloaded from
# https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem).
# Leave blank for local/GoDaddy MySQL, which don't use this CA chain.
DB_SSL_CA=

# ── Email (Gmail requires a 16-character App Password, not the account password) ─
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=replace-with-sender@gmail.com
EMAIL_HOST_PASSWORD=replace-with-16-char-app-password
DEFAULT_FROM_EMAIL=replace-with-sender@gmail.com

# ── Default admin accounts (seeded by `python manage.py create_default_admins`,
# already wired into scripts/deploy.sh) ───────────────────────────────────────
# Idempotent — only ever creates an account if no user with that email
# exists yet; never touches/resets an existing account's password. Leave an
# *_EMAIL blank to skip seeding that one. Passwords go through Django's
# normal AUTH_PASSWORD_VALIDATORS (min length, not too common, etc.) and are
# stored hashed via set_password() — never in plaintext.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ── Super Admin IP allowlist (optional) ───────────────────────────────────────
# Comma-separated IPs and/or CIDR ranges, e.g. "203.0.113.5,198.51.100.0/24".
# Leave blank to leave the Super Admin portal unrestricted (default). When
# set, both fresh logins AND already-issued Super Admin tokens are rejected
# from any other IP — see authapp/utils/ip_allowlist.py. Changing this
# requires a Passenger restart, same as ALLOWED_HOSTS.
SUPERADMIN_IP_ALLOWLIST=

# ── Third-party ────────────────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=replace-with-real-key

# Canonical public origin, used to build the absolute <loc> URLs in
# /sitemap.xml. Must match SITE_URL in the frontend's src/config/seo.js.
# Search Console rejects a sitemap whose URLs point at a different host, so
# set this per-environment rather than leaving the production default on a
# dev/staging box.
SITE_BASE_URL=https://jackpotsworld.vip

# Optional, comma-separated RSS feed URLs — leave blank to skip
EVENT_RSS_FEEDS=
POKER_RSS_FEEDS=

# ── VOICE-CALL: in-app WebRTC support calling ─────────────────────────────────
# Signaling rides the existing Channels/Redis layer; audio is peer-to-peer and
# never reaches this server. Calling is automatically unavailable wherever
# LIVE_CHAT_REALTIME is false (i.e. no REDIS_URL outside `runserver`), because
# signaling has to cross the gunicorn/daphne process boundary — the client
# hides the call button rather than ringing into nothing.

# Master switch. Leave true; set false to withdraw the feature without a deploy.
VOICE_CALL_ENABLED=True

# Seconds an unanswered call rings before the backend marks it "missed".
# Enforced server-side from CallSession.ring_expires_at, not a browser timer.
VOICE_CALL_RING_TIMEOUT_SECONDS=30

# Per-account cap on call initiation (DRF throttle rate). Accept/reject/end are
# deliberately never throttled, so nobody can be stranded in a call they can't
# hang up.
VOICE_CALL_START_RATE=6/min

# ── Call recording ────────────────────────────────────────────────────────────
# The agent's browser mixes both sides of the audio and uploads it when the call
# ends — the call is peer-to-peer, so there is no media server here to record
# from. One flag drives both halves: it turns the agent's recorder on AND shows
# the customer a "this call is recorded" notice before they speak. Turning it
# off removes both, so a recording can never be made without the notice.
#
# WHERE THE AUDIO GOES. With AWS_STORAGE_BUCKET_NAME set, recordings go to the
# private S3 backend (presigned URLs), the same one KYC documents use. With it
# unset they go to VOICE_CALL_RECORDING_ROOT below — deliberately NOT MEDIA_ROOT,
# because authapp/views/media_serve_views.serve_media publishes everything under
# MEDIA_ROOT with no permission check at all, and a recording's filename contains
# a sequential call id. Inside MEDIA_ROOT they would be downloadable by anyone
# who can count. Never point the root below inside MEDIA_ROOT.
#
# DURABILITY. Local disk on Elastic Beanstalk does NOT survive an instance
# replacement. Do not switch this on in production expecting durable recordings
# until S3 media storage is live.
#
# Playback is never a storage URL: the API hands out a path to an authorised
# endpoint that re-checks entitlement per request (only the agent who handled
# the call, or a superuser). Jurisdictions requiring explicit consent rather
# than notice should keep this off until such a flow exists.
VOICE_CALL_RECORDING_ENABLED=True

# Hard ceiling on one uploaded recording. Opus runs roughly 1 MB per 10 minutes
# of speech, so the 25 MB default is about two hours.
VOICE_CALL_RECORDING_MAX_BYTES=26214400

# Where recordings land when S3 is not configured. Defaults to a sibling of
# MEDIA_ROOT (see above for why it must never be inside it). On Elastic
# Beanstalk keep this outside /var/app/current so a deploy does not delete them.
VOICE_CALL_RECORDING_ROOT=

# STUN — comma-separated. Lets a browser learn its own public address. Leave
# unset to use the built-in list of several public servers: one host is a
# single point of failure, and a peer that gathers no server-reflexive
# candidate cannot reach anyone outside its own LAN.
WEBRTC_STUN_URLS=

# TURN — comma-separated. REQUIRED IN PRODUCTION, and the single most common
# reason a call "connects but has no audio".
#
# STUN alone works only when at least one side's NAT permits a direct path.
# That path does not exist behind carrier-grade NAT (normal on mobile data, so
# this is the ordinary case for a player calling from a phone), symmetric NAT,
# or a firewall that blocks UDP. Those calls ring, connect, show a timer and
# carry silence. A relay is the only route for them.
#
# Set-up runbook, including the coturn config and installer: deploy/turn/.
# After setting these, verify with:  python manage.py check_turn
#
# List every transport — ICE tries them in parallel and takes whichever
# answers, so a network that blocks UDP still gets TCP, and one that allows
# nothing but 443 still gets TLS:
#   turn:turn.example.com:3478?transport=udp,
#   turn:turn.example.com:3478?transport=tcp,
#   turns:turn.example.com:443?transport=tcp
WEBRTC_TURN_URLS=

# Preferred: the coturn shared secret (use-auth-secret). The server mints a
# short-lived credential per config request instead of handing every browser a
# permanent one. Must match /etc/coturn-secret on the TURN instance exactly.
WEBRTC_TURN_STATIC_AUTH_SECRET=
WEBRTC_TURN_CREDENTIAL_TTL=3600

# Fallback: a fixed username/password pair, for relay providers that do not
# support the shared-secret scheme. Ignored when the secret above is set.
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# Preferred over the static username/credential pair above when your TURN
# server supports it (coturn's `use-auth-secret`). The server then mints a
# short-lived credential per request, so one scraped out of a browser stops
# working within the TTL. The secret itself is never sent to any client.
WEBRTC_TURN_STATIC_AUTH_SECRET=
WEBRTC_TURN_CREDENTIAL_TTL=3600

# ── Visitor analytics ─────────────────────────────────────────────────────────
# Whether visitor IP addresses are PERSISTED. Location resolution works either
# way — with this off the address is still used transiently to look up
# country/region/city, it is simply never written to the database. Turn it off
# if the site's privacy policy stops permitting retention; nothing else in the
# analytics system depends on the stored value.
ANALYTICS_STORE_IP=True

# How long a stored address is kept before `manage.py prune_analytics_ips`
# blanks it. Pruning does NOT touch the derived country/region/city, so
# historical location reports survive the address being forgotten. Run the
# command from cron; it is idempotent.
ANALYTICS_IP_RETENTION_DAYS=90

# A visit ends after this much inactivity, so a tab left open overnight starts
# a new session in the morning instead of reporting one 14-hour visit.
ANALYTICS_SESSION_IDLE_MINUTES=30

# Kill switch for outbound IP-geolocation lookups (ip-api.com). Set to False if
# the provider ever misbehaves in production — it takes effect on the next
# request with no deploy. Country still resolves from Cloudflare's CF-IPCountry
# header when the zone sends one; region/city go blank (shown as "Unknown",
# never guessed).
ANALYTICS_RESOLVE_LOCATION=True

# Shared DatabaseCache sizing (production only). This cache holds the login
# throttle counters and the failed-login account lockout as well as the
# analytics rollups and the IP-geolocation cache, so Django's default
# MAX_ENTRIES of 300 is far too small — once exceeded, every write culls a
# slice of the whole cache and can silently reset a lockout. Raise rather than
# lower these.
CACHE_MAX_ENTRIES=50000
CACHE_CULL_FREQUENCY=20
